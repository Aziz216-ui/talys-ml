# Clé API Groq (Obtenez votre clé gratuite sur https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Modèle Groq par défaut
GROQ_MODEL=openai/gpt-oss-120b

# Data Mart MySQL (mysql = lecture MySQL, csv = fichiers data/raw)
DATA_SOURCE=mysql
MYSQL_URL=mysql+pymysql://root:@127.0.0.1:3306/talys_datamart
# Base hebergee (ex. Aiven) : URL + certificat CA telecharge depuis la console
# MYSQL_URL=mysql+pymysql://avnadmin:MOT_DE_PASSE@HOTE.aivencloud.com:PORT/talys_datamart
# MYSQL_SSL_CA=certs/ca.pem
